{
  "name": "rp",
  "version": "2.12.4.6",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run cf:dev",
    "astro:dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build",
    "preview": "wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1",
    "local": "npm run build && node scripts/local.mjs 127.0.0.1",
    "cf:dev": "npm run build && wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1",
    "cf:deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/cloudflare": "14.4.6",
    "@lucide/astro": "^1.24.0",
    "@vplayer/core": "^0.4.5",
    "@vplayer/react": "^0.4.5",
    "astro": "7.4.8",
    "ebml": "^3.0.0",
    "jassub": "^2.5.7",
    "mediabunny": "1.61.4",
    "movi-player": "0.4.1",
    "playsvideo": "0.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "latest"
  },
  "overrides": {
    "playsvideo": {
      "mediabunny": "https://codeload.github.com/kzahel/mediabunny/tar.gz/cd3cd2beb9c122dfa6fa89edbd7a73f2fa9df7a0"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "wrangler": "4.159.0"
  }
