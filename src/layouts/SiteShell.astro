---
import "../styles/global.css";
import { env as workerEnv } from "cloudflare:workers";

interface Props {
  title: string;
}

const { title } = Astro.props;
const env = workerEnv as Record<string, string | undefined>;
const umamiSrc = env.US || import.meta.env.US;
const umamiWebsiteId = env.UI || import.meta.env.UI;
const umamiHostUrl = env.UH || import.meta.env.UH;
const umamiDomains = env.UD || import.meta.env.UD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Re Player link-based media library." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {
      umamiSrc && umamiWebsiteId && (
        <script
          is:inline
          defer
          src={umamiSrc}
          data-website-id={umamiWebsiteId}
          data-host-url={umamiHostUrl || undefined}
          data-domains={umamiDomains || undefined}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
