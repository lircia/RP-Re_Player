---
import SiteShell from "../layouts/SiteShell.astro";

const cookie = Astro.request.headers.get("cookie") || "";
const saved = cookie.match(/(?:^|;\s*)rp_l=([^;]+)/)?.[1] || "";
const accept = (Astro.request.headers.get("accept-language") || "").toLowerCase();
const initialLang = saved === "zh" || saved === "ja" || saved === "en" ? saved : accept.startsWith("zh") ? "zh" : accept.startsWith("ja") ? "ja" : "en";
const currentPath = Astro.url.pathname;
const initialMessage = initialLang === "zh" ? "此页面已被神秘拦截" : initialLang === "ja" ? "このページは和歌山に配布されました" : "404:Not found";
const initialHome = initialLang === "zh" ? "返回 Local" : initialLang === "ja" ? "Localへ戻る" : "Back to Local";
---

<SiteShell title="404 - Re-Player">
  <main id="errorPage" class="error-page" data-lang={initialLang} data-path={currentPath}>
    <div class="error-mark">404</div>
    <p id="errorMessage" class="error-message">{initialMessage}</p>
    <p id="errorTree" class="error-tree">Trees: {currentPath}</p>
    <a href="/Local" id="errorHome">{initialHome}</a>
  </main>
  <script is:inline>
    (() => {
      const page = document.querySelector<HTMLElement>("#errorPage");
      const message = document.querySelector<HTMLElement>("#errorMessage");
      const tree = document.querySelector<HTMLElement>("#errorTree");
      const home = document.querySelector<HTMLAnchorElement>("#errorHome");
      if (!page || !message || !tree || !home) return;
      const saved = document.cookie.split("; ").find((part) => part.startsWith("rp_l="))?.slice(5) || "";
      const browser = (navigator.language || "").toLowerCase();
      const valid = (value) => value === "zh" || value === "ja" || value === "en";
      const apply = (lang) => {
        page.dataset.lang = lang;
        document.documentElement.lang = lang === "zh" ? "zh-CN" : lang;
        const messages = {
          zh: ["此页面已被神秘拦截", "Trees: "+page.dataset.path, "返回 Local"],
          ja: ["このページは和歌山に配布されました", "Trees: "+page.dataset.path, "Localへ戻る"],
          en: ["404:Not found", "Trees: "+page.dataset.path, "Back to Local"]
        };
        const text = messages[lang] || messages.en;
        message.textContent = text[0]; tree.textContent = text[1]; home.textContent = text[2];
      };
      const localLang = valid(saved) ? saved : browser.startsWith("zh") ? "zh" : browser.startsWith("ja") ? "ja" : "en";
      apply(localLang);
      if (!valid(saved)) fetch("/api/public/geo").then((response) => response.json()).then((data) => {
        if (data?.ok && valid(data.lang)) { document.cookie = `rp_l=${encodeURIComponent(data.lang)}; Path=/; Max-Age=31536000; SameSite=Lax`; apply(data.lang); }
      }).catch(() => undefined);
    })();
  </script>
  <style>
    :global(html), :global(body) { margin: 0; min-height: 100%; background: #101214; }
    .error-page { min-height: 100vh; min-height: 100dvh; display: grid; place-content: center; justify-items: center; gap: 16px; padding: 24px; box-sizing: border-box; color: #eaf1f0; background: radial-gradient(circle at 20% 15%, #233b39, #101214 55%); font-family: Inter, system-ui, sans-serif; text-align: center; }
    .error-mark { color: #68d5b0; font-size: clamp(68px, 18vw, 180px); line-height: .8; letter-spacing: -.08em; font-weight: 700; }
    .error-message { margin: 0; font-size: clamp(20px, 4vw, 42px); }
    .error-tree { margin: 0; color: #9eafb0; font-family: ui-monospace, monospace; overflow-wrap: anywhere; }
    .error-page a { color: #101614; background: #68d5b0; padding: 10px 18px; text-decoration: none; }
  </style>
</SiteShell>
