---
import {
  ArrowLeft,
  Captions,
  FileImage,
  Film,
  Folder,
  Languages,
  Music2,
  Maximize,
  Minimize,
  Pause,
  Play,
  RefreshCw,
  Repeat,
  Repeat1,
  Search,
  Shuffle,
  Volume2,
  VolumeX
} from "@lucide/astro";
import SiteShell from "../layouts/SiteShell.astro";
---

<SiteShell title="Re-Player">
  <div class="media-app">
    <header class="app-topbar">
      <a class="app-brand" href="/" aria-label="Re-Player">
        <strong>Re-Player</strong>
      </a>

      <label class="search-box">
        <Search size={18} aria-hidden="true" />
        <span class="sr-only" data-i18n="search">Search library</span>
        <input id="searchInput" type="search" placeholder="Search library" data-i18n-placeholder="search" autocomplete="off" />
      </label>

      <label class="language-box">
        <Languages size={18} aria-hidden="true" />
        <span class="sr-only" data-i18n="language">Language</span>
        <select id="languageSelect" aria-label="Language">
          <option value="en">English</option>
          <option value="zh">简体中文</option>
          <option value="ja">日本語</option>
        </select>
      </label>
    </header>

    <div class="media-workspace">
      <aside class="library-pane" aria-label="Media library">
        <div class="library-heading">
          <div>
            <p class="section-kicker" data-i18n="library">Library</p>
            <h1 id="pathTitle">/</h1>
          </div>
          <div class="icon-actions">
            <button id="parentBtn" class="icon-button" type="button" title="Parent folder" data-i18n-title="parent">
              <ArrowLeft size={19} />
              <span class="sr-only" data-i18n="parent">Parent folder</span>
            </button>
            <button id="refreshBtn" class="icon-button" type="button" title="Refresh" data-i18n-title="refresh">
              <RefreshCw size={18} />
              <span class="sr-only" data-i18n="refresh">Refresh</span>
            </button>
          </div>
        </div>

        <nav id="fileList" class="file-list" aria-live="polite">
          <div class="list-state" data-i18n="loading">Loading...</div>
        </nav>

        <div class="library-footer">
          <span id="itemCount">0 items</span>
          <span id="libraryStatus" class="status-text" role="status"></span>
        </div>
      </aside>

      <main class="player-pane">
        <section id="playerStage" class="player-stage">
          <div id="emptyPlayer" class="player-empty">
            <span class="player-empty-mark"><Play size={34} fill="currentColor" /></span>
            <strong data-i18n="nothingPlaying">Nothing playing</strong>
            <span>Re Player</span>
          </div>

          <div id="videoFrame" class="video-frame" tabindex="0" hidden>
            <video id="videoPlayer" playsinline preload="metadata"></video>
            <div id="videoControls" class="video-controls">
              <label class="video-seek">
                <span class="sr-only" data-i18n="seek">Seek</span>
                <input id="videoSeek" type="range" min="0" max="0" value="0" step="0.1" aria-label="Seek" />
              </label>
              <div class="video-control-row">
                <button id="playToggle" class="player-control" type="button" title="Play" aria-label="Play">
                  <span id="playIcon"><Play size={19} fill="currentColor" /></span>
                  <span id="pauseIcon" hidden><Pause size={19} fill="currentColor" /></span>
                </button>
                <output id="videoTime" class="video-time">00:00 / 00:00</output>
                <span class="video-control-spacer"></span>
                <button id="muteToggle" class="player-control" type="button" title="Mute" aria-label="Mute">
                  <span id="volumeIcon"><Volume2 size={19} /></span>
                  <span id="mutedIcon" hidden><VolumeX size={19} /></span>
                </button>
                <label class="volume-control">
                  <span class="sr-only" data-i18n="volume">Volume</span>
                  <input id="videoVolume" type="range" min="0" max="1" value="1" step="0.05" aria-label="Volume" />
                </label>
                <button id="fullscreenToggle" class="player-control" type="button" title="Fullscreen" aria-label="Fullscreen">
                  <span id="fullscreenIcon"><Maximize size={19} /></span>
                  <span id="exitFullscreenIcon" hidden><Minimize size={19} /></span>
                </button>
              </div>
            </div>
          </div>

          <div id="imageFrame" class="image-frame" hidden>
            <img id="imageViewer" alt="" />
          </div>

          <div id="audioFrame" class="audio-frame" hidden>
            <div class="audio-overview">
              <div class="audio-cover-shell">
                <img id="audioPoster" class="audio-poster" src="/poster.svg" alt="" />
              </div>
              <div class="audio-copy">
                <div class="audio-heading">
                  <Music2 size={26} />
                  <div>
                    <strong id="audioTitle">Re Player</strong>
                    <span id="audioPath">/</span>
                  </div>
                </div>
                <audio id="audioPlayer" preload="metadata"></audio>
                <div class="audio-controls">
                  <label class="audio-seek">
                    <span class="sr-only" data-i18n="seek">Seek</span>
                    <input id="audioSeek" type="range" min="0" max="0" value="0" step="0.1" aria-label="Seek" />
                  </label>
                  <div class="audio-control-row">
                    <button id="audioPlayToggle" class="player-control" type="button" title="Play" aria-label="Play">
                      <span id="audioPlayIcon"><Play size={19} fill="currentColor" /></span>
                      <span id="audioPauseIcon" hidden><Pause size={19} fill="currentColor" /></span>
                    </button>
                    <output id="audioTime" class="video-time">00:00 / 00:00</output>
                    <span class="video-control-spacer"></span>
                    <button id="audioModeToggle" class="player-control" type="button" title="Repeat one" aria-label="Repeat one">
                      <span id="audioModeOneIcon"><Repeat1 size={19} /></span>
                      <span id="audioModeListIcon" hidden><Repeat size={19} /></span>
                      <span id="audioModeShuffleIcon" hidden><Shuffle size={19} /></span>
                    </button>
                    <button id="audioMuteToggle" class="player-control" type="button" title="Mute" aria-label="Mute">
                      <span id="audioVolumeIcon"><Volume2 size={19} /></span>
                      <span id="audioMutedIcon" hidden><VolumeX size={19} /></span>
                    </button>
                    <label class="volume-control audio-volume-control">
                      <span class="sr-only" data-i18n="volume">Volume</span>
                      <input id="audioVolume" type="range" min="0" max="1" value="1" step="0.05" aria-label="Volume" />
                    </label>
                  </div>
                </div>
              </div>
            </div>
            <section id="lyricsPanel" class="lyrics-panel" hidden>
              <div id="lyricsList" class="lyrics-list" aria-live="off"></div>
            </section>
          </div>
        </section>

        <section class="now-playing">
          <div class="now-playing-copy">
            <div class="media-labels">
              <span id="kindBadge" class="media-badge" data-i18n="ready">Ready</span>
              <span id="subtitleBadge" class="media-badge subtitle-badge" hidden>
                <Captions size={14} /> ASS
              </span>
              <span id="lyricsBadge" class="media-badge subtitle-badge" hidden>
                <Music2 size={14} /> LRC
              </span>
            </div>
            <h2 id="mediaTitle" data-i18n="nothingSelected">Nothing selected</h2>
            <p id="mediaPath">/</p>
          </div>
        </section>

        <div id="playerStatus" class="player-status" role="status"></div>
      </main>
    </div>
  </div>

  <template id="iconFolder"><Folder size={20} /></template>
  <template id="iconVideo"><Film size={20} /></template>
  <template id="iconAudio"><Music2 size={20} /></template>
  <template id="iconImage"><FileImage size={20} /></template>

  <script>
    import JASSUB from "jassub";
    import { buildLyrics, type LyricCue } from "../lib/lrc";

    const c = {
      en: {
        search: "Search library",
        language: "Language",
        library: "Library",
        parent: "Parent folder",
        refresh: "Refresh",
        loading: "Loading...",
        empty: "This folder is empty",
        nothingPlaying: "Nothing playing",
        nothingSelected: "Nothing selected",
        ready: "Ready",
        folder: "Folder",
        video: "Video",
        audio: "Audio",
        image: "Image",
        item: "item",
        items: "items",
        loadFailed: "Could not load this folder.",
        itemFailed: "Could not open this media.",
        subFailed: "The ASS subtitle could not be loaded.",
        playing: "Now playing",
        play: "Play",
        pause: "Pause",
        mute: "Mute",
        unmute: "Unmute",
        seek: "Seek",
        volume: "Volume",
        repeatOne: "Repeat one",
        repeatList: "Repeat list",
        shuffle: "Shuffle",
        fullscreen: "Fullscreen",
        exitFullscreen: "Exit fullscreen",
        lyricsLoading: "Loading lyrics...",
        lyricsEmpty: "No timed lyrics",
        lyricsFailed: "Lyrics could not be loaded"
      },
      zh: {
        search: "搜索媒体库",
        language: "语言",
        library: "媒体库",
        parent: "上级目录",
        refresh: "刷新",
        loading: "正在加载...",
        empty: "此目录为空",
        nothingPlaying: "暂无播放内容",
        nothingSelected: "尚未选择媒体",
        ready: "就绪",
        folder: "目录",
        video: "视频",
        audio: "音频",
        image: "图片",
        item: "项",
        items: "项",
        loadFailed: "无法读取此目录。",
        itemFailed: "无法打开此媒体。",
        subFailed: "ASS 字幕加载失败。",
        playing: "正在播放",
        play: "播放",
        pause: "暂停",
        mute: "静音",
        unmute: "取消静音",
        seek: "播放进度",
        volume: "音量",
        repeatOne: "单曲循环",
        repeatList: "列表循环",
        shuffle: "随机播放",
        fullscreen: "全屏",
        exitFullscreen: "退出全屏",
        lyricsLoading: "正在加载歌词...",
        lyricsEmpty: "暂无时间轴歌词",
        lyricsFailed: "歌词加载失败"
      },
      ja: {
        search: "ライブラリを検索",
        language: "言語",
        library: "ライブラリ",
        parent: "親フォルダー",
        refresh: "更新",
        loading: "読み込み中...",
        empty: "このフォルダーは空です",
        nothingPlaying: "再生中のメディアはありません",
        nothingSelected: "メディアが選択されていません",
        ready: "準備完了",
        folder: "フォルダー",
        video: "動画",
        audio: "音声",
        image: "画像",
        item: "件",
        items: "件",
        loadFailed: "フォルダーを読み込めませんでした。",
        itemFailed: "メディアを開けませんでした。",
        subFailed: "ASS字幕を読み込めませんでした。",
        playing: "再生中",
        play: "再生",
        pause: "一時停止",
        mute: "ミュート",
        unmute: "ミュート解除",
        seek: "再生位置",
        volume: "音量",
        repeatOne: "1曲リピート",
        repeatList: "リストリピート",
        shuffle: "シャッフル",
        fullscreen: "全画面",
        exitFullscreen: "全画面を終了",
        lyricsLoading: "歌詞を読み込み中...",
        lyricsEmpty: "同期歌詞がありません",
        lyricsFailed: "歌詞を読み込めませんでした"
      }
    } as const;

    type Lang = keyof typeof c;
    type AudioMode = "one" | "list" | "shuffle";
    type MediaItem = {
      id?: string;
      name: string;
      path: string;
      url?: string;
      kind?: "video" | "audio" | "image";
      artist?: string;
      poster?: string;
      sub?: string;
      lrc?: string;
      lrc2?: string;
      isDir?: boolean;
    };

    const s: {
      path: string;
      items: MediaItem[];
      audioQueue: MediaItem[];
      current: MediaItem | null;
      lang: Lang;
      ass: JASSUB | null;
      lyrics: LyricCue[];
      lyricIndex: number;
      lyricToken: number;
      lyricManual: boolean;
      lyricScrollTimer: number;
      audioMode: AudioMode;
    } = {
      path: "/root",
      items: [],
      audioQueue: [],
      current: null,
      lang: "en",
      ass: null,
      lyrics: [],
      lyricIndex: -1,
      lyricToken: 0,
      lyricManual: false,
      lyricScrollTimer: 0,
      audioMode: "one"
    };

    const d = {
      search: document.querySelector<HTMLInputElement>("#searchInput")!,
      language: document.querySelector("#languageSelect") as unknown as HTMLSelectElement,
      path: document.querySelector<HTMLElement>("#pathTitle")!,
      list: document.querySelector<HTMLElement>("#fileList")!,
      count: document.querySelector<HTMLElement>("#itemCount")!,
      libraryStatus: document.querySelector<HTMLElement>("#libraryStatus")!,
      parent: document.querySelector<HTMLButtonElement>("#parentBtn")!,
      refresh: document.querySelector<HTMLButtonElement>("#refreshBtn")!,
      stage: document.querySelector<HTMLElement>("#playerStage")!,
      empty: document.querySelector<HTMLElement>("#emptyPlayer")!,
      videoFrame: document.querySelector<HTMLElement>("#videoFrame")!,
      video: document.querySelector<HTMLVideoElement>("#videoPlayer")!,
      videoControls: document.querySelector<HTMLElement>("#videoControls")!,
      playToggle: document.querySelector<HTMLButtonElement>("#playToggle")!,
      playIcon: document.querySelector<HTMLElement>("#playIcon")!,
      pauseIcon: document.querySelector<HTMLElement>("#pauseIcon")!,
      seek: document.querySelector<HTMLInputElement>("#videoSeek")!,
      time: document.querySelector<HTMLOutputElement>("#videoTime")!,
      muteToggle: document.querySelector<HTMLButtonElement>("#muteToggle")!,
      volumeIcon: document.querySelector<HTMLElement>("#volumeIcon")!,
      mutedIcon: document.querySelector<HTMLElement>("#mutedIcon")!,
      volume: document.querySelector<HTMLInputElement>("#videoVolume")!,
      fullscreenToggle: document.querySelector<HTMLButtonElement>("#fullscreenToggle")!,
      fullscreenIcon: document.querySelector<HTMLElement>("#fullscreenIcon")!,
      exitFullscreenIcon: document.querySelector<HTMLElement>("#exitFullscreenIcon")!,
      imageFrame: document.querySelector<HTMLElement>("#imageFrame")!,
      image: document.querySelector<HTMLImageElement>("#imageViewer")!,
      audioFrame: document.querySelector<HTMLElement>("#audioFrame")!,
      audio: document.querySelector<HTMLAudioElement>("#audioPlayer")!,
      audioPlayToggle: document.querySelector<HTMLButtonElement>("#audioPlayToggle")!,
      audioPlayIcon: document.querySelector<HTMLElement>("#audioPlayIcon")!,
      audioPauseIcon: document.querySelector<HTMLElement>("#audioPauseIcon")!,
      audioSeek: document.querySelector<HTMLInputElement>("#audioSeek")!,
      audioTime: document.querySelector<HTMLOutputElement>("#audioTime")!,
      audioModeToggle: document.querySelector<HTMLButtonElement>("#audioModeToggle")!,
      audioModeOneIcon: document.querySelector<HTMLElement>("#audioModeOneIcon")!,
      audioModeListIcon: document.querySelector<HTMLElement>("#audioModeListIcon")!,
      audioModeShuffleIcon: document.querySelector<HTMLElement>("#audioModeShuffleIcon")!,
      audioMuteToggle: document.querySelector<HTMLButtonElement>("#audioMuteToggle")!,
      audioVolumeIcon: document.querySelector<HTMLElement>("#audioVolumeIcon")!,
      audioMutedIcon: document.querySelector<HTMLElement>("#audioMutedIcon")!,
      audioVolume: document.querySelector<HTMLInputElement>("#audioVolume")!,
      audioPoster: document.querySelector<HTMLImageElement>("#audioPoster")!,
      audioTitle: document.querySelector<HTMLElement>("#audioTitle")!,
      audioPath: document.querySelector<HTMLElement>("#audioPath")!,
      lyricsPanel: document.querySelector<HTMLElement>("#lyricsPanel")!,
      lyricsList: document.querySelector<HTMLElement>("#lyricsList")!,
      kind: document.querySelector<HTMLElement>("#kindBadge")!,
      subtitle: document.querySelector<HTMLElement>("#subtitleBadge")!,
      lyricsBadge: document.querySelector<HTMLElement>("#lyricsBadge")!,
      title: document.querySelector<HTMLElement>("#mediaTitle")!,
      mediaPath: document.querySelector<HTMLElement>("#mediaPath")!,
      playerStatus: document.querySelector<HTMLElement>("#playerStatus")!
    };
    let controlTimer = 0;
    let seeking = false;
    let audioSeeking = false;

    const e: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
    const esc = (v: unknown) => String(v ?? "").replace(/[&<>"']/g, (x) => e[x]);
    const t = (k: keyof (typeof c)["en"]) => c[s.lang][k];
    const displayPath = (path: string) => path.replace(/^\/root(?=\/|$)/, "") || "/";
    const subtitleFontUrls = async (content: string) => {
      const characters = [...new Set([...content].filter((character) => {
        const point = character.codePointAt(0) || 0;
        return point >= 0x20 && point !== 0x7f;
      }))];
      const chunks = Array.from(
        { length: Math.max(1, Math.ceil(characters.length / 700)) },
        (_, part) => characters.slice(part * 700, (part + 1) * 700).join("")
      );
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 6000);
      try {
        const urls = await Promise.all(chunks.map(async (text) => {
          const url = new URL("https://fonts.googleapis.com/css2");
          url.searchParams.set("family", "Noto Sans SC:wght@400");
          url.searchParams.set("text", text);
          const response = await fetch(url, { signal: controller.signal });
          if (!response.ok) throw new Error("Font CSS request failed.");
          const css = await response.text();
          const font = css.match(/url\((https:\/\/[^)]+)\)/)?.[1];
          if (!font) throw new Error("Font URL was not found.");
          return font;
        }));
        const fonts = await Promise.all(urls.map(async (url) => {
          const response = await fetch(url, { signal: controller.signal });
          if (!response.ok) throw new Error("Font request failed.");
          return new Uint8Array(await response.arrayBuffer());
        }));
        return { fonts, defaultFont: "Noto Sans SC" };
      } catch {
        const kana = [...content].filter((character) => {
          const point = character.codePointAt(0) || 0;
          return point >= 0x3040 && point <= 0x30ff;
        }).length;
        const han = [...content].filter((character) => {
          const point = character.codePointAt(0) || 0;
          return point >= 0x4e00 && point <= 0x9fff;
        }).length;
        const japanese = kana * 3 > han;
        const url = japanese ? "/fonts/NotoSansJP-Regular.woff2" : "/fonts/NotoSansSC-Regular.woff2";
        const response = await fetch(url);
        return {
          fonts: response.ok ? [new Uint8Array(await response.arrayBuffer())] : [],
          defaultFont: japanese ? "Noto Sans JP" : "Noto Sans SC"
        };
      } finally {
        window.clearTimeout(timer);
      }
    };
    const normalizeAssFonts = (content: string, font: string) => {
      let styles = false;
      return content.split(/\r?\n/).map((line) => {
        if (/^\s*\[(V4\+? Styles)\]\s*$/i.test(line)) {
          styles = true;
          return line;
        }
        if (/^\s*\[.+\]\s*$/.test(line)) styles = false;
        if (styles && /^\s*Style\s*:/i.test(line)) {
          const fields = line.split(",");
          if (fields.length > 2) fields[1] = font;
          line = fields.join(",");
        }
        return line.replace(/\\fn[^\\}]+/g, `\\fn${font}`);
      }).join("\n");
    };
    const icon = (item: MediaItem) => {
      const id = item.isDir ? "iconFolder" : item.kind === "audio" ? "iconAudio" : item.kind === "image" ? "iconImage" : "iconVideo";
      return document.querySelector<HTMLTemplateElement>(`#${id}`)?.innerHTML ?? "";
    };
    const type = (item: MediaItem) => item.isDir ? "folder" : item.kind || "video";

    function setStatus(el: HTMLElement, message = "", tone = "") {
      el.textContent = message;
      tone ? (el.dataset.tone = tone) : delete el.dataset.tone;
    }

    const formatTime = (seconds: number) => {
      if (!Number.isFinite(seconds) || seconds < 0) return "00:00";
      const whole = Math.floor(seconds);
      const hours = Math.floor(whole / 3600);
      const minutes = Math.floor((whole % 3600) / 60);
      const rest = whole % 60;
      return hours
        ? `${hours}:${String(minutes).padStart(2, "0")}:${String(rest).padStart(2, "0")}`
        : `${String(minutes).padStart(2, "0")}:${String(rest).padStart(2, "0")}`;
    };

    const setRangeFill = (input: HTMLInputElement, value: number) => {
      input.style.setProperty("--range-fill", `${Math.max(0, Math.min(100, value))}%`);
    };

    function scheduleControls(delay = document.fullscreenElement === d.videoFrame ? 1600 : 2200) {
      window.clearTimeout(controlTimer);
      if (seeking || (d.video.paused && document.fullscreenElement !== d.videoFrame)) return;
      controlTimer = window.setTimeout(() => d.videoFrame.classList.add("controls-hidden"), delay);
    }

    function showControls(lock = false) {
      window.clearTimeout(controlTimer);
      d.videoFrame.classList.remove("controls-hidden");
      if (!lock) scheduleControls();
    }

    function updateVideoControls() {
      const paused = d.video.paused;
      const muted = d.video.muted || d.video.volume === 0;
      const fullscreen = document.fullscreenElement === d.videoFrame;
      const duration = Number.isFinite(d.video.duration) ? d.video.duration : 0;
      d.videoFrame.dataset.playing = paused ? "0" : "1";
      d.playIcon.hidden = !paused;
      d.pauseIcon.hidden = paused;
      d.playToggle.title = d.playToggle.ariaLabel = t(paused ? "play" : "pause");
      d.volumeIcon.hidden = muted;
      d.mutedIcon.hidden = !muted;
      d.muteToggle.title = d.muteToggle.ariaLabel = t(muted ? "unmute" : "mute");
      d.fullscreenIcon.hidden = fullscreen;
      d.exitFullscreenIcon.hidden = !fullscreen;
      d.fullscreenToggle.title = d.fullscreenToggle.ariaLabel = t(fullscreen ? "exitFullscreen" : "fullscreen");
      d.seek.ariaLabel = t("seek");
      d.volume.ariaLabel = t("volume");
      d.seek.max = String(duration);
      if (!seeking) d.seek.value = String(Math.min(d.video.currentTime || 0, duration));
      d.volume.value = String(muted ? 0 : d.video.volume);
      d.time.value = `${formatTime(d.video.currentTime)} / ${formatTime(duration)}`;
      setRangeFill(d.seek, duration ? (Number(d.seek.value) / duration) * 100 : 0);
      setRangeFill(d.volume, Number(d.volume.value) * 100);
    }

    function updateAudioControls() {
      const paused = d.audio.paused;
      const muted = d.audio.muted || d.audio.volume === 0;
      const duration = Number.isFinite(d.audio.duration) ? d.audio.duration : 0;
      const modeKey = s.audioMode === "one" ? "repeatOne" : s.audioMode === "list" ? "repeatList" : "shuffle";
      d.audioFrame.classList.toggle("is-playing", !paused);
      d.audioPlayIcon.hidden = !paused;
      d.audioPauseIcon.hidden = paused;
      d.audioPlayToggle.title = d.audioPlayToggle.ariaLabel = t(paused ? "play" : "pause");
      d.audioVolumeIcon.hidden = muted;
      d.audioMutedIcon.hidden = !muted;
      d.audioMuteToggle.title = d.audioMuteToggle.ariaLabel = t(muted ? "unmute" : "mute");
      d.audioModeOneIcon.hidden = s.audioMode !== "one";
      d.audioModeListIcon.hidden = s.audioMode !== "list";
      d.audioModeShuffleIcon.hidden = s.audioMode !== "shuffle";
      d.audioModeToggle.title = d.audioModeToggle.ariaLabel = t(modeKey);
      d.audioSeek.ariaLabel = t("seek");
      d.audioVolume.ariaLabel = t("volume");
      d.audioSeek.max = String(duration);
      if (!audioSeeking) d.audioSeek.value = String(Math.min(d.audio.currentTime || 0, duration));
      d.audioVolume.value = String(muted ? 0 : d.audio.volume);
      d.audioTime.value = `${formatTime(d.audio.currentTime)} / ${formatTime(duration)}`;
      setRangeFill(d.audioSeek, duration ? (Number(d.audioSeek.value) / duration) * 100 : 0);
      setRangeFill(d.audioVolume, Number(d.audioVolume.value) * 100);
    }

    function togglePlay() {
      if (d.video.paused) d.video.play().catch(() => undefined);
      else d.video.pause();
    }

    function toggleAudioPlay() {
      if (d.audio.paused) d.audio.play().catch(() => undefined);
      else d.audio.pause();
    }

    function cycleAudioMode() {
      s.audioMode = s.audioMode === "one" ? "list" : s.audioMode === "list" ? "shuffle" : "one";
      updateAudioControls();
    }

    async function continueAudio() {
      if (s.audioMode === "one") {
        d.audio.currentTime = 0;
        await d.audio.play().catch(() => undefined);
        return;
      }

      const tracks = s.audioQueue;
      const alternatives = tracks.filter((item) => item.path !== s.current?.path);
      if (!alternatives.length) return;
      let next: MediaItem;
      if (s.audioMode === "shuffle") {
        next = alternatives[Math.floor(Math.random() * alternatives.length)];
      } else {
        const current = tracks.findIndex((item) => item.path === s.current?.path);
        next = tracks[(current + 1 + tracks.length) % tracks.length];
      }
      await openItem(next.path);
    }

    function setLyricsState(key: "lyricsLoading" | "lyricsEmpty" | "lyricsFailed") {
      d.lyricsPanel.hidden = false;
      d.lyricsList.innerHTML = `<div class="lyrics-state">${esc(t(key))}</div>`;
    }

    function resetLyrics() {
      window.clearTimeout(s.lyricScrollTimer);
      s.lyricToken += 1;
      s.lyrics = [];
      s.lyricIndex = -1;
      s.lyricManual = false;
      d.lyricsList.replaceChildren();
      d.lyricsPanel.hidden = true;
    }

    function centerLyric(line: HTMLElement, behavior: ScrollBehavior) {
      const listBox = d.lyricsList.getBoundingClientRect();
      const lineBox = line.getBoundingClientRect();
      const top = d.lyricsList.scrollTop + lineBox.top - listBox.top - (listBox.height - lineBox.height) / 2;
      d.lyricsList.scrollTo({ top: Math.max(0, top), behavior });
    }

    function pauseLyricFollow() {
      s.lyricManual = true;
      window.clearTimeout(s.lyricScrollTimer);
      s.lyricScrollTimer = window.setTimeout(() => {
        s.lyricManual = false;
        syncLyrics(true);
      }, 3000);
    }

    function syncLyrics(force = false) {
      if (!s.lyrics.length) return;
      const now = d.audio.currentTime + 0.05;
      let low = 0;
      let high = s.lyrics.length - 1;
      let index = -1;
      while (low <= high) {
        const middle = (low + high) >> 1;
        if (s.lyrics[middle].at <= now) {
          index = middle;
          low = middle + 1;
        } else {
          high = middle - 1;
        }
      }
      if (!force && index === s.lyricIndex) return;

      const previous = d.lyricsList.querySelector<HTMLElement>(".is-active");
      previous?.classList.remove("is-active");
      previous?.removeAttribute("aria-current");
      s.lyricIndex = index;
      if (index < 0) {
        d.lyricsList.scrollTo({ top: 0, behavior: force ? "auto" : "smooth" });
        return;
      }

      const line = d.lyricsList.querySelector<HTMLElement>(`[data-lyric="${index}"]`);
      if (!line) return;
      line.classList.add("is-active");
      line.setAttribute("aria-current", "true");
      if (force || !s.lyricManual) centerLyric(line, force ? "auto" : "smooth");
    }

    function renderLyrics(cues: LyricCue[]) {
      s.lyrics = cues;
      s.lyricIndex = -1;
      if (!cues.length) return setLyricsState("lyricsEmpty");
      d.lyricsPanel.hidden = false;
      d.lyricsList.innerHTML = cues.map((cue, index) => {
        const top = cue.top || cue.bottom || "";
        const bottom = cue.top ? cue.bottom : undefined;
        return `
          <button class="lyric-line" type="button" data-lyric="${index}" data-at="${cue.at}">
            <span class="lyric-top">${esc(top)}</span>
            ${bottom ? `<span class="lyric-bottom">${esc(bottom)}</span>` : ""}
          </button>
        `;
      }).join("");
      syncLyrics(true);
    }

    async function loadLyrics(item: MediaItem) {
      const token = ++s.lyricToken;
      setLyricsState("lyricsLoading");
      const fetchTrack = async (slot: 1 | 2) => {
        const response = await fetch(`/api/public/lyric?path=${encodeURIComponent(item.path)}&n=${slot}`);
        if (!response.ok) throw new Error("Lyrics request failed.");
        return response.text();
      };
      const [primary, other] = await Promise.all([
        item.lrc ? fetchTrack(1).catch(() => null) : Promise.resolve(null),
        item.lrc2 ? fetchTrack(2).catch(() => null) : Promise.resolve(null)
      ]);
      if (token !== s.lyricToken) return;
      if (primary === null && other === null) return setLyricsState("lyricsFailed");
      renderLyrics(primary && other ? buildLyrics(primary, other) : buildLyrics(primary || other || ""));
    }

    async function toggleFullscreen() {
      if (document.fullscreenElement) await document.exitFullscreen();
      else await d.videoFrame.requestFullscreen();
      d.videoFrame.focus({ preventScroll: true });
    }

    function applyLanguage() {
      document.documentElement.lang = s.lang === "zh" ? "zh-CN" : s.lang === "ja" ? "ja" : "en";
      document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
        const key = el.dataset.i18n as keyof (typeof c)["en"];
        if (key && c[s.lang][key]) el.textContent = t(key);
      });
      document.querySelectorAll<HTMLElement>("[data-i18n-title]").forEach((el) => {
        const key = el.dataset.i18nTitle as keyof (typeof c)["en"];
        if (key && c[s.lang][key]) el.title = t(key);
      });
      document.querySelectorAll<HTMLInputElement>("[data-i18n-placeholder]").forEach((el) => {
        const key = el.dataset.i18nPlaceholder as keyof (typeof c)["en"];
        if (key && c[s.lang][key]) el.placeholder = t(key);
      });
      updateVideoControls();
      updateAudioControls();
      render();
      renderCurrent();
    }

    function render() {
      d.path.textContent = displayPath(s.path);
      d.parent.disabled = s.path === "/root";
      const q = d.search.value.trim().toLocaleLowerCase(s.lang);
      const items = s.items.filter((item) => !q || `${item.name} ${item.path}`.toLocaleLowerCase(s.lang).includes(q));
      d.count.textContent = `${items.length} ${items.length === 1 ? t("item") : t("items")}`;
      if (!items.length) {
        d.list.innerHTML = `<div class="list-state">${esc(t("empty"))}</div>`;
        return;
      }
      d.list.innerHTML = items.map((item) => `
        <button class="file-row${s.current?.path === item.path ? " is-active" : ""}" type="button" data-path="${esc(item.path)}" data-dir="${item.isDir ? "1" : "0"}">
          <span class="file-icon file-icon-${esc(type(item))}">${icon(item)}</span>
          <span class="file-copy">
            <strong>${esc(item.name)}</strong>
            <small>${esc(item.artist || t(type(item) as "folder" | "video" | "audio" | "image"))}</small>
          </span>
        </button>
      `).join("");
    }

    function renderCurrent() {
      if (!s.current) return;
      d.kind.textContent = t(s.current.kind || "video");
      d.title.textContent = s.current.name;
      d.mediaPath.textContent = s.current.artist || displayPath(s.current.path);
      d.subtitle.hidden = !s.current.sub;
      d.lyricsBadge.hidden = !s.current.lrc && !s.current.lrc2;
    }

    async function load(path = s.path) {
      setStatus(d.libraryStatus, t("loading"));
      const response = await fetch("/api/public/list", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ path })
      });
      const data = (await response.json()) as any;
      if (!data.ok) throw new Error(data.details || data.error || t("loadFailed"));
      s.path = data.path || "/root";
      s.items = data.items || [];
      setStatus(d.libraryStatus);
      render();
    }

    async function clearMedia() {
      if (s.ass) {
        await s.ass.destroy().catch(() => undefined);
        s.ass = null;
      }
      d.video.pause();
      d.audio.pause();
      d.video.removeAttribute("src");
      d.audio.removeAttribute("src");
      d.image.removeAttribute("src");
      d.videoFrame.hidden = true;
      d.videoFrame.classList.remove("controls-hidden");
      window.clearTimeout(controlTimer);
      d.imageFrame.hidden = true;
      d.audioFrame.hidden = true;
      d.audioFrame.classList.remove("is-playing");
      d.audioSeek.value = "0";
      d.audioSeek.max = "0";
      d.audioTime.value = "00:00 / 00:00";
      setRangeFill(d.audioSeek, 0);
      delete d.stage.dataset.mode;
      resetLyrics();
      d.empty.hidden = true;
    }

    async function openItem(path: string) {
      setStatus(d.playerStatus, t("loading"));
      const response = await fetch("/api/public/item", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ path })
      });
      const data = (await response.json()) as any;
      if (!data.ok) throw new Error(data.details || data.error || t("itemFailed"));
      const item: MediaItem = data.item;
      const audioQueue = s.items.filter((entry) => !entry.isDir && entry.kind === "audio");
      await clearMedia();
      s.current = item;
      if (item.kind === "audio") s.audioQueue = audioQueue;
      renderCurrent();
      render();

      if (item.kind === "image") {
        d.stage.dataset.mode = "image";
        d.imageFrame.hidden = false;
        d.image.src = item.url || "";
        d.image.alt = item.name;
      } else if (item.kind === "audio") {
        d.stage.dataset.mode = "audio";
        d.audioFrame.hidden = false;
        d.audioPoster.src = item.poster || "/poster.svg";
        d.audioPoster.alt = item.name;
        d.audioTitle.textContent = item.name;
        d.audioPath.textContent = item.artist || displayPath(item.path);
        d.audio.src = item.url || "";
        d.audio.load();
        updateAudioControls();
        if (item.lrc || item.lrc2) loadLyrics(item).catch(() => setLyricsState("lyricsFailed"));
        d.audio.play().catch(() => undefined);
      } else {
        d.stage.dataset.mode = "video";
        d.videoFrame.hidden = false;
        d.video.poster = item.poster || "/poster.svg";
        d.video.src = item.url || "";
        d.video.load();
        updateVideoControls();
        showControls();
        if (item.sub) {
          try {
            const subUrl = `/api/public/sub?path=${encodeURIComponent(item.path)}`;
            const response = await fetch(subUrl);
            if (!response.ok) throw new Error("Subtitle request failed.");
            const rawSubtitle = await response.text();
            const fontPromise = subtitleFontUrls(rawSubtitle);
            const subContent = normalizeAssFonts(rawSubtitle, "Noto Sans SC");
            const ass = new JASSUB({
              video: d.video,
              subContent
            });
            s.ass = ass;
            d.videoFrame.dataset.subtitleReady = "0";
            Promise.all([ass.ready, fontPromise]).then(async ([, font]) => {
              if (s.ass !== ass) return;
              await ass.renderer.addFonts(font.fonts);
              ass.renderer.setDefaultFont(font.defaultFont);
              await ass.resize(true);
              d.videoFrame.dataset.subtitleReady = "1";
            }).catch(() => {
              if (s.ass === ass) setStatus(d.playerStatus, t("subFailed"), "error");
            });
          } catch {
            setStatus(d.playerStatus, t("subFailed"), "error");
          }
        }
        d.video.play().catch(() => undefined);
      }
      if (!d.playerStatus.dataset.tone) setStatus(d.playerStatus, t("playing"));
    }

    d.list.addEventListener("click", (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>("[data-path]");
      if (!row?.dataset.path) return;
      const action = row.dataset.dir === "1" ? load(row.dataset.path) : openItem(row.dataset.path);
      action.catch((error) => setStatus(row.dataset.dir === "1" ? d.libraryStatus : d.playerStatus, error.message, "error"));
    });

    d.parent.addEventListener("click", () => {
      const parent = s.path.split("/").filter(Boolean).slice(0, -1).join("/");
      load(parent ? `/${parent}` : "/root").catch((error) => setStatus(d.libraryStatus, error.message, "error"));
    });
    d.refresh.addEventListener("click", () => load().catch((error) => setStatus(d.libraryStatus, error.message, "error")));
    d.search.addEventListener("input", render);
    d.audio.addEventListener("timeupdate", () => {
      syncLyrics();
      updateAudioControls();
    });
    d.audio.addEventListener("seeked", () => syncLyrics(true));
    ["play", "pause", "durationchange", "loadedmetadata", "volumechange"].forEach((event) => {
      d.audio.addEventListener(event, updateAudioControls);
    });
    d.audio.addEventListener("ended", () => {
      updateAudioControls();
      continueAudio().catch((error) => setStatus(d.playerStatus, error.message, "error"));
    });
    d.audioPlayToggle.addEventListener("click", toggleAudioPlay);
    d.audioModeToggle.addEventListener("click", cycleAudioMode);
    d.audioMuteToggle.addEventListener("click", () => {
      d.audio.muted = !d.audio.muted;
      if (!d.audio.muted && d.audio.volume === 0) d.audio.volume = 1;
    });
    d.audioSeek.addEventListener("pointerdown", () => {
      audioSeeking = true;
    });
    d.audioSeek.addEventListener("input", () => {
      d.audio.currentTime = Number(d.audioSeek.value);
      updateAudioControls();
      syncLyrics(true);
    });
    d.audioSeek.addEventListener("change", () => {
      audioSeeking = false;
      updateAudioControls();
    });
    d.audioVolume.addEventListener("input", () => {
      d.audio.muted = false;
      d.audio.volume = Number(d.audioVolume.value);
    });
    d.audioPoster.addEventListener("error", () => {
      if (!d.audioPoster.src.endsWith("/poster.svg")) d.audioPoster.src = "/poster.svg";
    });
    d.lyricsList.addEventListener("wheel", pauseLyricFollow, { passive: true });
    d.lyricsList.addEventListener("touchstart", pauseLyricFollow, { passive: true });
    d.lyricsList.addEventListener("click", (event) => {
      const line = (event.target as HTMLElement).closest<HTMLElement>("[data-at]");
      if (!line?.dataset.at) return;
      window.clearTimeout(s.lyricScrollTimer);
      s.lyricManual = false;
      d.audio.currentTime = Number(line.dataset.at);
      syncLyrics(true);
    });
    d.playToggle.addEventListener("click", togglePlay);
    d.muteToggle.addEventListener("click", () => {
      d.video.muted = !d.video.muted;
      if (!d.video.muted && d.video.volume === 0) d.video.volume = 1;
    });
    d.fullscreenToggle.addEventListener("click", () => toggleFullscreen().catch(() => undefined));
    d.video.addEventListener("click", togglePlay);
    d.video.addEventListener("dblclick", () => toggleFullscreen().catch(() => undefined));
    d.videoFrame.addEventListener("pointermove", () => showControls());
    d.videoFrame.addEventListener("pointerdown", () => d.videoFrame.focus({ preventScroll: true }));
    d.videoFrame.addEventListener("pointerleave", () => scheduleControls(600));
    d.videoControls.addEventListener("pointerenter", () => showControls());
    d.videoControls.addEventListener("pointerleave", () => scheduleControls(600));
    d.videoControls.addEventListener("focusin", () => showControls(document.fullscreenElement !== d.videoFrame));
    d.videoControls.addEventListener("focusout", () => showControls());
    d.seek.addEventListener("pointerdown", () => {
      seeking = true;
      showControls(true);
    });
    d.seek.addEventListener("input", () => {
      d.video.currentTime = Number(d.seek.value);
      updateVideoControls();
    });
    window.addEventListener("pointerup", () => {
      if (seeking) {
        seeking = false;
        scheduleControls();
      }
      if (audioSeeking) {
        audioSeeking = false;
        updateAudioControls();
      }
    });
    d.volume.addEventListener("input", () => {
      d.video.muted = false;
      d.video.volume = Number(d.volume.value);
    });
    ["play", "pause", "ended", "timeupdate", "durationchange", "loadedmetadata", "volumechange"].forEach((event) => {
      d.video.addEventListener(event, () => {
        updateVideoControls();
        if (event === "play") scheduleControls();
        if (event === "pause" || event === "ended") showControls(document.fullscreenElement !== d.videoFrame);
      });
    });
    document.addEventListener("fullscreenchange", () => {
      updateVideoControls();
      showControls();
      s.ass?.resize(true).catch(() => undefined);
    });
    document.addEventListener("keydown", (event) => {
      if (d.videoFrame.hidden) return;
      const active = document.activeElement;
      const controlsPlayer = document.fullscreenElement === d.videoFrame || active === d.videoFrame || (active instanceof Node && d.videoFrame.contains(active));
      if (!controlsPlayer || active instanceof HTMLInputElement) return;
      const key = event.key.toLowerCase();
      if (key === " " || key === "k") togglePlay();
      else if (key === "f") toggleFullscreen().catch(() => undefined);
      else if (key === "m") d.video.muted = !d.video.muted;
      else if (key === "arrowleft") d.video.currentTime = Math.max(0, d.video.currentTime - 5);
      else if (key === "arrowright") d.video.currentTime = Math.min(d.video.duration || Infinity, d.video.currentTime + 5);
      else return;
      event.preventDefault();
      showControls();
    });
    d.language.addEventListener("change", () => {
      s.lang = d.language.value as Lang;
      localStorage.setItem("rp_l", s.lang);
      applyLanguage();
    });

    async function detectLanguage() {
      try {
        const response = await fetch("/api/public/geo");
        const data = (await response.json()) as { ok?: boolean; lang?: Lang };
        if (!data.ok || (data.lang !== "en" && data.lang !== "zh" && data.lang !== "ja")) return;
        if (localStorage.getItem("rp_l")) return;
        s.lang = data.lang;
        d.language.value = s.lang;
        applyLanguage();
      } catch {
        // English remains the default when location detection is unavailable.
      }
    }

    const saved = localStorage.getItem("rp_l");
    if (saved === "zh" || saved === "ja" || saved === "en") s.lang = saved;
    d.language.value = s.lang;
    applyLanguage();
    if (!saved) detectLanguage();
    load("/root").catch((error) => setStatus(d.libraryStatus, error.message, "error"));
  </script>
</SiteShell>
